{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "timer-runner",
  "title": "Timer Runner",
  "description": "Set timers to run applications and system commands",
  "icon": "command-icon.png",
  "author": "your_name",
  "categories": [
    "Productivity",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "set-timer",
      "title": "Set Timer",
      "description": "Set a timer to run an application or system command",
      "mode": "view"
    },
    {
      "name": "manage-timers",
      "title": "Manage Timers",
      "description": "View and manage active timers",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.65.0",
    "@raycast/utils": "^1.12.0"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.8",
    "@types/jest": "^29.5.0",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "eslint": "^8.51.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.2.2"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "publish": "npx @raycast/api@latest publish"
  }
}
